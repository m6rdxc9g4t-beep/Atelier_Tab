{
  "name": "atelier-tab",
  "productName": "Atelier_Tab",
  "private": true,
  "version": "0.6.0",
  "description": "Tableur + base de données hybride avec export DataFlow vers atelier_projets",
  "author": "François Pichon",
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app": "npm run build && npm run build:desktop && node scripts/ensure-electron.mjs && electron .",
    "app:build": "node scripts/build-launcher.mjs && electron-builder --mac --dir",
    "app:update": "node desktop/launcher/cli.cjs",
    "app:install": "npm run app:build && node scripts/install-mac.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "ai:connect": "node scripts/connect-claude.mjs",
    "mcp": "npm run build:desktop && node dist-desktop/atelier-mcp.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-virtual": "^3.14.21",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.59.0",
    "nanoid": "^6.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "fr.atelier.tab",
    "productName": "Atelier_Tab",
    "copyright": "© 2026 François Pichon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/launcher/stub.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/launcher/stub.cjs"
    },
    "asar": true,
    "afterPack": "scripts/adhoc-sign.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "extraResources": [
      {
        "from": "dist-launcher/atelier-repo",
        "to": "atelier-repo"
      },
      {
        "from": "desktop/bin/atelier-mcp",
        "to": "atelier-mcp"
      }
    ]
  }
}
